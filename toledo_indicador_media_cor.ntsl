// Toledo Média Cor
// Indicador anti-ansiedade e anti-cagada rs
input
  Periodo(20);
  Dados(Close);
var
  nIndex  : Integer;
  sSum    : Float;
  sResult : Float;
  sFactor : Float;
begin
  if (CurrentBar = Periodo-1) then
    begin
      sSum := 0;
      for nIndex := 0 to Periodo-1 do
        sSum := sSum + Dados[nIndex];
      sResult := sSum / Periodo;
      Plot(sResult);
    end
  else if (CurrentBar > Periodo-1) then
    begin
      sFactor := 2 / (Periodo + 1);
      sResult := Dados * sFactor + sResult[1] * (1 - sFactor);
      Plot(sResult);
    end;
  if (close > sResult) then
    SetPlotColor(1, RGB(23, 98, 210))
  else if (close < sResult) then
    SetPlotColor(1, RGB(204, 37, 7));
end;